{
	"schemaVersion": 1,
	"id": "modid",
	"version": "${version}",
	"name": "Cute Mod",
	"description": "A mod that adds everything that I want in the game",
	"authors": [
		"Jh1236"
	],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/jh1236/cutemod"
	},
	"license": "CC0-1.0",
	"icon": "assets/cutemod/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"me.jh1236.ExampleMod"
		],
		"client": [
			"me.jh1236.ClientMessageManager",
			"me.jh1236.ClientZoomManager"
		],
		"modmenu": [
			"me.jh1236.config.ModMenuIntegration"
		]
	},
	"mixins": [
		"jh1236.mixins.json",
		{
			"config": "jh1236.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.16.9",
		"minecraft": "~1.21.6",
		"java": ">=21",
		"fabric-api": "*",
		"fabric-key-binding-api-v1": "*"
	},
	"suggests": {
		"another-mod": "*"
	},
	"custom": {
		"modmenu": {
			"links": {
				"modmenu.discord": "https://discord.gg/jEGF5fb"
			},
			"badges": [  ],
			"update_checker": true
		}
	}
}